# Copy and export before starting production jars:
#   set -a && source .env.production && set +a

SPRING_PROFILES_ACTIVE=production

SERVER_PORT=8080
SERVER_CONTEXT_PATH=

DB_URL=jdbc:postgresql://localhost:5432/jobsdb
DB_USERNAME=jobs
DB_PASSWORD=jobs
DB_POOL_SIZE=10

# Optional API base path (stream is always {base}/stream)
APP_API_JOBS_BASE_PATH=/api/jobs

WORKER_POLL_INTERVAL_MS=2000
WORKER_PROCESSING_DELAY_MS=3000
